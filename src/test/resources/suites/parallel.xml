<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Tüm testler, 4 thread'de metot bazında paralel. Çalıştır: mvn test -Dsuite=parallel -->
<suite name="SauceDemo Playwright - Parallel" parallel="methods" thread-count="4" verbose="1">
    <test name="Parallel UI Tests">
        <classes>
            <class name="com.servet.pw.tests.LoginTest"/>
            <class name="com.servet.pw.tests.InventoryTest"/>
            <class name="com.servet.pw.tests.CheckoutTest"/>
        </classes>
    </test>
</suite>
